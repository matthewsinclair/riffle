# Intent configuration
intent/.config/cache/
intent/.config/backup/
# `intent agents sync` writes this beside the regenerated AGENTS.md. Ten of
# the eleven devbin estates already ignored it; this one did not, so the tool's
# own backup showed up as untracked noise here and nowhere else (sweep #6).
/AGENTS.md.bak

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*~
.vscode/
.idea/

# Elixir
/_build/
/cover/
/deps/
/doc/
/.fetch
erl_crash.dump
*.ez
riffle-*.tar
/tmp/
.elixir_ls/
.elixir-tools/

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# Treeindex cache (derived, machine-local; regenerate with 'intent treeindex <dir>').
intent/.treeindex/

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# Intent migration backups (machine-local, never committed).
.backup/
intent/.backup/

# Intent's hook carriers are SHIPPED CANON, written by `intent claude upgrade
# --apply` into whatever `git rev-parse --git-path hooks` resolves to -- .githooks
# here, since core.hooksPath points at it (the guards adoption pass, 2026-10-23).
# The dispatchers beside them are tracked so a clone receives them; the carriers
# are the installer's, and a fresh clone gets them from `intent claude upgrade
# --apply`, refusing every commit as GATE ABSENT until it runs.
.githooks/*.intent
